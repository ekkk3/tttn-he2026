VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Đăng nhập Google (tuỳ chọn): dán Client ID Web tạo tại Google Cloud Console.
# Xem docs/HUONG_DAN_TICH_HOP.md mục 1. Bỏ trống thì ẩn nút đăng nhập Google.
VITE_GOOGLE_CLIENT_ID=

# Đăng nhập Facebook (tuỳ chọn): dán App ID tạo tại Facebook for Developers.
# Xem docs/HUONG_DAN_TICH_HOP.md mục 1. Bỏ trống thì ẩn nút đăng nhập Facebook.
VITE_FACEBOOK_APP_ID=
