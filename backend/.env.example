PORT=8000
APP_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Dung de tao link "Dat lai mat khau" gui qua email.
FRONTEND_URL=http://localhost:5173

# SMTP: gui email "Quen mat khau" that. Neu bo trong, backend se in noi dung email
# (kem link reset) ra console thay vi gui that — van kiem thu duoc luong logic.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dacsanvungmien.local

# Dang nhap Google: tao OAuth Client ID (Web) tai https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Dang nhap Facebook: tao App tai https://developers.facebook.com/apps
FACEBOOK_APP_ID=

# Optional. Neu bo trong, cart se doc/ghi thang MySQL (khong loi, chi khong co cache toc do cao).
REDIS_URL=redis://127.0.0.1:6379

# Optional. Neu bo trong, tim kiem san pham se fallback ve MySQL LIKE thay vi fuzzy search.
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_PRODUCTS_INDEX=products

# VNPay sandbox: dang ky merchant test tai https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# ReturnUrl tro ve trang FE hien ket qua; trang do goi backend xac minh chu ky.
VNPAY_RETURN_URL=http://localhost:5173/checkout/vnpay-return
# (Tuy chon) IPN server->server neu khai bao tren cong VNPay:
# VNPAY_IPN_URL=http://127.0.0.1:8000/api/payments/vnpay/ipn

# MoMo sandbox: https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:5173/checkout/momo-return
MOMO_NOTIFY_URL=http://127.0.0.1:8000/api/payments/momo/ipn

# GHN (Giao Hang Nhanh) - dung cho /api/shipping/ghn/* + tao van don, tinh phi.
# GHN_SHOP_ID + GHN_FROM_DISTRICT_ID lay trong trang quan ly Shop cua GHN (kho lay hang).
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api

# AI Chatbot: 'openai' hoac 'gemini'
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
