# Cau hinh rieng cho bo test tu dong (npm test) - KHONG dung chung DB voi .env that
# de test khong bao gio dung vao/xoa nham du lieu demo dang chay o ecommerce_db.
# vitest.setup.js nap file nay TRUOC khi bat ky module nao (vd config/db.js) duoc import,
# nen bien DB_NAME=ecommerce_test se co hieu luc ngay tu cau ket noi pool dau tien.

PORT=8001
APP_URL=http://127.0.0.1:8001
CORS_ORIGIN=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecommerce_test
DB_USER=root
DB_PASSWORD=

JWT_SECRET=test_secret_khong_dung_that
JWT_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173

# Rong het: khong goi dich vu ngoai that nao trong test (email/Redis/ES/GHN/VNPay/MoMo/AI).
# Cac controller da co san graceful fallback khi thieu cau hinh (da kiem chung o cac dot
# kiem thu truoc), nen test chi can kiem tra dung nhanh fallback nay, khong can mock rieng.
SMTP_HOST=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
REDIS_URL=
ELASTICSEARCH_NODE=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
GHN_TOKEN=
AI_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
